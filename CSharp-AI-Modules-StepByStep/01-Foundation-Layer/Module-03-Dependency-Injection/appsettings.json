{
  "UserService": {
    "MaxUsersPerRequest": 100,
    "EnableValidation": true,
    "CacheExpiry": "00:15:00"
  },
  "Cache": {
    "DefaultExpiry": "00:15:00",
    "MaxItems": 1000,
    "EnableCleanup": true
  },
  "Notification": {
    "EnableEmail": true,
    "EnableSms": false,
    "DefaultSender": "noreply@example.com",
    "RetryDelay": "00:00:30",
    "MaxRetries": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AI.DependencyInjection": "Debug"
    }
  },
  "AllowedHosts": "*"
}