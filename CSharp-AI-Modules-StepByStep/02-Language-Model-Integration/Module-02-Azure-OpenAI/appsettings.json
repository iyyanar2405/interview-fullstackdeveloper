{
  "AzureOpenAI": {
    "Endpoint": "https://your-resource.openai.azure.com/",
    "ApiKey": null,
    "UseManagedIdentity": true,
    "DeploymentName": "gpt-35-turbo",
    "EmbeddingDeploymentName": "text-embedding-ada-002",
    "ModelName": "gpt-35-turbo",
    "TimeoutSeconds": 120,
    "MaxRetryAttempts": 3,
    "ContentFilter": {
      "Enabled": true,
      "HateThreshold": "Medium",
      "SexualThreshold": "Medium",
      "ViolenceThreshold": "Medium",
      "SelfHarmThreshold": "Low",
      "LogFilteredContent": true
    },
    "RateLimit": {
      "Enabled": true,
      "RequestsPerMinute": 60,
      "TokensPerMinute": 60000,
      "QueueRequests": true
    },
    "Logging": {
      "LogRequests": true,
      "LogResponses": true,
      "LogTokenUsage": true,
      "LogPerformance": true,
      "MaxContentLength": 1000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AI.AzureOpenAI": "Debug"
    }
  },
  "AllowedHosts": "*"
}