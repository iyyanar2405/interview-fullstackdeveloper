{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "AI.Anthropic": "Trace"
    }
  },
  
  "Anthropic": {
    "ApiKey": "your-development-anthropic-api-key-here",
    "BaseUrl": "https://api.anthropic.com/v1",
    "Version": "2023-06-01",
    "TimeoutSeconds": 600,
    "DefaultModel": "claude-3-haiku-20240307",
    "MaxRetries": 5,
    "RetryDelayMs": 500
  },
  
  "RateLimit": {
    "Claude": {
      "PermitLimit": 1000,
      "WindowMinutes": 1,
      "QueueLimit": 100
    },
    "ClaudeStream": {
      "PermitLimit": 200,
      "WindowMinutes": 1,
      "QueueLimit": 50
    }
  },
  
  "ConstitutionalAI": {
    "ValidationThreshold": 0.5,
    "AutoImprovement": true,
    "DetailedLogging": true
  },
  
  "LongContext": {
    "DefaultChunkOverlap": 200,
    "MaxChunks": 100,
    "ChunkingStrategy": "semantic",
    "SynthesisModel": "claude-3-haiku-20240307",
    "EnableDebugging": true
  },
  
  "Swagger": {
    "Enabled": true,
    "RoutePrefix": "",
    "IncludeXmlComments": true,
    "ShowSchemas": true
  },
  
  "Cache": {
    "TokenEstimates": {
      "ExpirationMinutes": 5,
      "MaxEntries": 100
    },
    "ConstitutionalValidation": {
      "ExpirationMinutes": 5,
      "MaxEntries": 50
    }
  },
  
  "Monitoring": {
    "RequestLogging": true,
    "PerformanceMetrics": true,
    "ErrorTracking": true,
    "DetailedRequestLogging": true,
    "LogRequestBodies": true,
    "LogResponseBodies": true
  }
}