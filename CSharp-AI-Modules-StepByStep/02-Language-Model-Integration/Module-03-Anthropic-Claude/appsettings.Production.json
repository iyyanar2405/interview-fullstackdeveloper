{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "AI.Anthropic": "Information"
    }
  },
  
  "Anthropic": {
    "TimeoutSeconds": 120,
    "MaxRetries": 2,
    "RetryDelayMs": 2000
  },
  
  "RateLimit": {
    "Claude": {
      "PermitLimit": 50,
      "WindowMinutes": 1,
      "QueueLimit": 20
    },
    "ClaudeStream": {
      "PermitLimit": 10,
      "WindowMinutes": 1,
      "QueueLimit": 5
    }
  },
  
  "ConstitutionalAI": {
    "ValidationThreshold": 0.8,
    "AutoImprovement": false
  },
  
  "LongContext": {
    "MaxChunks": 20
  },
  
  "Swagger": {
    "Enabled": false
  },
  
  "Cache": {
    "TokenEstimates": {
      "ExpirationMinutes": 120,
      "MaxEntries": 5000
    },
    "ConstitutionalValidation": {
      "ExpirationMinutes": 60,
      "MaxEntries": 2000
    }
  },
  
  "Monitoring": {
    "DetailedRequestLogging": false,
    "LogRequestBodies": false,
    "LogResponseBodies": false
  }
}