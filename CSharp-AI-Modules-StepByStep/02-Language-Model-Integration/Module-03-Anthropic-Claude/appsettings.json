{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "AI.Anthropic": "Debug"
    }
  },
  "AllowedHosts": "*",
  
  "Anthropic": {
    "ApiKey": "your-anthropic-api-key-here",
    "BaseUrl": "https://api.anthropic.com/v1",
    "Version": "2023-06-01",
    "TimeoutSeconds": 300,
    "DefaultModel": "claude-3-sonnet-20240229",
    "MaxRetries": 3,
    "RetryDelayMs": 1000
  },
  
  "RateLimit": {
    "Claude": {
      "PermitLimit": 100,
      "WindowMinutes": 1,
      "QueueLimit": 50
    },
    "ClaudeStream": {
      "PermitLimit": 20,
      "WindowMinutes": 1,
      "QueueLimit": 10
    }
  },
  
  "ConstitutionalAI": {
    "DefaultPrinciples": [
      "Be helpful and provide accurate information",
      "Be harmless and avoid content that could cause harm",
      "Be honest and acknowledge uncertainty when appropriate",
      "Respect human autonomy and avoid being overly directive",
      "Be transparent about reasoning and limitations",
      "Avoid illegal or unethical content",
      "Respect privacy and confidentiality",
      "Be inclusive and avoid discriminatory language",
      "Provide balanced perspectives on controversial topics",
      "Encourage critical thinking and informed decision-making"
    ],
    "ValidationThreshold": 0.7,
    "AutoImprovement": true
  },
  
  "LongContext": {
    "DefaultChunkOverlap": 100,
    "MaxChunks": 50,
    "ChunkingStrategy": "semantic",
    "SynthesisModel": "claude-3-sonnet-20240229"
  },
  
  "Swagger": {
    "Enabled": true,
    "RoutePrefix": "swagger",
    "Title": "Anthropic Claude API",
    "Description": "API for interacting with Anthropic Claude models with Constitutional AI features"
  },
  
  "CORS": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3001",
      "http://localhost:5000",
      "https://localhost:5001"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": true
  },
  
  "HealthChecks": {
    "UI": {
      "Enabled": true,
      "Path": "/health-ui"
    }
  },
  
  "Cache": {
    "TokenEstimates": {
      "ExpirationMinutes": 60,
      "MaxEntries": 1000
    },
    "ConstitutionalValidation": {
      "ExpirationMinutes": 30,
      "MaxEntries": 500
    }
  },
  
  "Monitoring": {
    "RequestLogging": true,
    "PerformanceMetrics": true,
    "ErrorTracking": true
  }
}