{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "PromptEngineering": {
    "TemplateStoragePath": "Templates",
    "DefaultTemplateEngine": "Scriban",
    "EnableCaching": true,
    "CacheExpirationMinutes": 60,
    "EnableOptimization": true,
    "EnableVersioning": true
  }
}
