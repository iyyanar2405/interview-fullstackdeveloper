{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AI.ModelManagement": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ModelManagement": {
    "Models": [
      {
        "ModelId": "gpt-4-turbo",
        "Name": "GPT-4 Turbo",
        "Provider": "OpenAI",
        "Capabilities": ["TextGeneration", "ChatCompletion", "CodeGeneration", "Reasoning"],
        "Pricing": {
          "InputTokenCost": 0.01,
          "OutputTokenCost": 0.03,
          "RequestCost": 0.0,
          "Currency": "USD"
        },
        "Limits": {
          "MaxTokens": 4096,
          "MaxRequestsPerMinute": 3500,
          "MaxConcurrentRequests": 100,
          "ContextWindow": 128000
        },
        "Status": "Available",
        "Priority": 1
      },
      {
        "ModelId": "gpt-3.5-turbo",
        "Name": "GPT-3.5 Turbo",
        "Provider": "OpenAI",
        "Capabilities": ["TextGeneration", "ChatCompletion", "CodeGeneration"],
        "Pricing": {
          "InputTokenCost": 0.0005,
          "OutputTokenCost": 0.0015,
          "RequestCost": 0.0,
          "Currency": "USD"
        },
        "Limits": {
          "MaxTokens": 4096,
          "MaxRequestsPerMinute": 10000,
          "MaxConcurrentRequests": 200,
          "ContextWindow": 16385
        },
        "Status": "Available",
        "Priority": 2
      },
      {
        "ModelId": "claude-3-opus",
        "Name": "Claude 3 Opus",
        "Provider": "Anthropic",
        "Capabilities": ["TextGeneration", "ChatCompletion", "Reasoning", "CodeGeneration"],
        "Pricing": {
          "InputTokenCost": 0.015,
          "OutputTokenCost": 0.075,
          "RequestCost": 0.0,
          "Currency": "USD"
        },
        "Limits": {
          "MaxTokens": 4096,
          "MaxRequestsPerMinute": 2000,
          "MaxConcurrentRequests": 50,
          "ContextWindow": 200000
        },
        "Status": "Available",
        "Priority": 1
      },
      {
        "ModelId": "claude-3-sonnet",
        "Name": "Claude 3 Sonnet",
        "Provider": "Anthropic",
        "Capabilities": ["TextGeneration", "ChatCompletion", "Reasoning"],
        "Pricing": {
          "InputTokenCost": 0.003,
          "OutputTokenCost": 0.015,
          "RequestCost": 0.0,
          "Currency": "USD"
        },
        "Limits": {
          "MaxTokens": 4096,
          "MaxRequestsPerMinute": 5000,
          "MaxConcurrentRequests": 100,
          "ContextWindow": 200000
        },
        "Status": "Available",
        "Priority": 2
      },
      {
        "ModelId": "azure-gpt-4",
        "Name": "Azure GPT-4",
        "Provider": "AzureOpenAI",
        "Capabilities": ["TextGeneration", "ChatCompletion", "CodeGeneration", "Reasoning"],
        "Pricing": {
          "InputTokenCost": 0.01,
          "OutputTokenCost": 0.03,
          "RequestCost": 0.0,
          "Currency": "USD"
        },
        "Limits": {
          "MaxTokens": 4096,
          "MaxRequestsPerMinute": 5000,
          "MaxConcurrentRequests": 150,
          "ContextWindow": 128000
        },
        "Status": "Available",
        "Priority": 1
      }
    ],
    "FallbackConfig": {
      "Strategy": "Sequential",
      "Rules": [
        {
          "TriggerCondition": "RateLimit",
          "FallbackModelIds": ["gpt-3.5-turbo", "claude-3-sonnet"],
          "Priority": 1,
          "MaintainCapabilities": true
        },
        {
          "TriggerCondition": "Timeout",
          "FallbackModelIds": ["gpt-3.5-turbo"],
          "Priority": 2,
          "MaintainCapabilities": false
        }
      ],
      "MaxRetries": 3,
      "RetryDelayMs": 1000,
      "EnableCircuitBreaker": true
    },
    "CostConfig": {
      "DailyBudget": 100.0,
      "MonthlyBudget": 2000.0,
      "EnableAutoScaling": true,
      "EnableCostAlerts": true,
      "AlertThresholdPercentage": 80.0,
      "Rules": [
        {
          "Name": "SwitchToCheaper",
          "ThresholdAmount": 80.0,
          "Action": "SwitchToCheaper",
          "TargetModelIds": ["gpt-3.5-turbo", "claude-3-sonnet"]
        }
      ]
    },
    "LoadBalancingConfig": {
      "Enabled": true,
      "Strategy": "WeightedRoundRobin",
      "ModelWeights": {
        "gpt-4-turbo": 3,
        "gpt-3.5-turbo": 5,
        "claude-3-opus": 2,
        "claude-3-sonnet": 4
      },
      "HealthCheckIntervalSeconds": 60
    },
    "MonitoringSettings": {
      "EnablePerformanceTracking": true,
      "EnableCostTracking": true,
      "EnableHealthChecks": true,
      "MetricsRetentionDays": 30,
      "HealthCheckIntervalSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
