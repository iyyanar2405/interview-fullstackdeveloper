{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "DataSources": {
    "SqlServer": {
      "Server": "localhost",
      "Database": "AIDataSource",
      "UserId": "sa",
      "Password": "YourPassword123!",
      "Timeout": 30,
      "MaxPoolSize": 100
    },
    "PostgreSQL": {
      "Host": "localhost",
      "Port": 5432,
      "Database": "ai_datasource",
      "Username": "postgres",
      "Password": "postgres",
      "Timeout": 30,
      "MaxPoolSize": 100
    },
    "MongoDB": {
      "ConnectionString": "mongodb://localhost:27017",
      "Database": "ai_datasource",
      "Username": "",
      "Password": "",
      "MaxPoolSize": 100,
      "MinPoolSize": 10,
      "UseSSL": false,
      "AuthenticationDatabase": "admin"
    },
    "AzureBlobStorage": {
      "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net",
      "ContainerName": "datasources",
      "MaxConcurrentUploads": 5
    },
    "AwsS3": {
      "BucketName": "ai-datasources",
      "Region": "us-east-1",
      "AccessKeyId": "YOUR_ACCESS_KEY",
      "SecretAccessKey": "YOUR_SECRET_KEY",
      "MaxConcurrentUploads": 5
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "DefaultDatabase": 0,
      "Password": "",
      "ConnectTimeout": 5000,
      "SyncTimeout": 5000
    },
    "FileSystem": {
      "BasePath": "C:\\AIData",
      "EnableWatching": true,
      "AllowedExtensions": [ ".txt", ".csv", ".json", ".xml" ]
    },
    "ApiClients": {
      "DefaultTimeout": 30,
      "MaxRetries": 3,
      "RetryDelaySeconds": 2
    }
  }
}
