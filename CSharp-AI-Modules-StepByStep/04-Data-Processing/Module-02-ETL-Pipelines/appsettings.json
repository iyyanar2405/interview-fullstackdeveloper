{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ETLSettings": {
    "DefaultBatchSize": 1000,
    "MaxDegreeOfParallelism": 4,
    "DefaultTimeout": 300,
    "MaxRetries": 3,
    "RetryDelaySeconds": 5,
    "EnableCaching": true,
    "CacheDurationMinutes": 60,
    "ErrorLogPath": "logs/errors",
    "MemoryLimitMB": 2048
  },
  "DataSources": {
    "SqlServer": {
      "ConnectionString": "Server=localhost;Database=ETL_Source;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;",
      "CommandTimeout": 30
    },
    "PostgreSQL": {
      "ConnectionString": "Host=localhost;Port=5432;Database=etl_source;Username=postgres;Password=postgres;",
      "CommandTimeout": 30
    },
    "MongoDB": {
      "ConnectionString": "mongodb://localhost:27017",
      "Database": "etl_source",
      "Collection": "data"
    },
    "Destination": {
      "SqlServer": "Server=localhost;Database=ETL_Destination;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;",
      "PostgreSQL": "Host=localhost;Port=5432;Database=etl_destination;Username=postgres;Password=postgres;",
      "MongoDB": "mongodb://localhost:27017"
    }
  },
  "ValidationRules": {
    "EnableValidation": true,
    "FailOnError": true,
    "FailOnWarning": false,
    "MaxErrors": 100
  },
  "PerformanceSettings": {
    "UseBulkInsert": true,
    "BulkInsertBatchSize": 5000,
    "UseParallelProcessing": true,
    "MaxParallelTasks": 8
  }
}
