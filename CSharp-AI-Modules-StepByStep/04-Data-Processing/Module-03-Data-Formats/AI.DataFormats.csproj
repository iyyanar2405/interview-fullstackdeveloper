<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />

    <!-- JSON Processing -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json.Schema" Version="3.0.15" />
    
    <!-- CSV Processing -->
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    <PackageReference Include="TinyCsvParser" Version="2.7.0" />
    
    <!-- Excel Processing -->
    <PackageReference Include="ExcelDataReader" Version="3.6.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.6.0" />
    <PackageReference Include="ClosedXML" Version="0.102.1" />
    <PackageReference Include="EPPlus" Version="7.0.3" />
    <PackageReference Include="NPOI" Version="2.7.0" />
    
    <!-- Parquet Processing -->
    <PackageReference Include="Parquet.Net" Version="4.15.0" />
    
    <!-- XML Processing -->
    <PackageReference Include="System.Xml.Linq" Version="4.3.0" />
    <PackageReference Include="System.Xml.XmlSerializer" Version="4.3.0" />
    <PackageReference Include="System.Xml.XPath.XmlDocument" Version="4.3.0" />
    
    <!-- HTML Processing -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.57" />
    <PackageReference Include="AngleSharp" Version="1.1.2" />
    
    <!-- Binary Format Processing -->
    <PackageReference Include="MessagePack" Version="2.5.140" />
    <PackageReference Include="protobuf-net" Version="3.2.30" />
    <PackageReference Include="Avro" Version="1.11.3" />
    
    <!-- Data Validation -->
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    
    <!-- Compression -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.6" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    
    <!-- AutoMapper -->
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    
    <!-- Utilities -->
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
