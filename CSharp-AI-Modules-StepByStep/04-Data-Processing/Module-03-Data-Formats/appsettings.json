{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "FormatSettings": {
    "MaxFileSizeBytes": 104857600,
    "DefaultEncoding": "UTF-8",
    "EnableCaching": true,
    "CacheExpirationMinutes": 30
  },
  "JsonSettings": {
    "MaxDepth": 100,
    "SchemaValidationEnabled": true,
    "AllowTrailingCommas": false
  },
  "CsvSettings": {
    "DefaultDelimiter": ",",
    "DefaultEncoding": "UTF-8",
    "AutoDetectDelimiter": true,
    "MaxRowsForDelimiterDetection": 100
  },
  "ExcelSettings": {
    "MaxWorksheets": 50,
    "MaxRowsPerSheet": 1048576,
    "AutoFitColumns": true,
    "DefaultDateFormat": "yyyy-MM-dd"
  },
  "ParquetSettings": {
    "DefaultCompression": "Snappy",
    "MaxRowGroupSize": 5000,
    "EnableStatistics": true
  },
  "XmlSettings": {
    "EnableXsdValidation": true,
    "MaxDepth": 100,
    "PreserveWhitespace": false
  },
  "HtmlSettings": {
    "EnableSanitization": true,
    "AllowedTags": ["p", "div", "span", "a", "img", "table", "tr", "td", "th", "ul", "ol", "li", "h1", "h2", "h3", "h4", "h5", "h6"],
    "AllowedAttributes": ["href", "src", "alt", "class", "id"]
  },
  "ConversionSettings": {
    "PreserveMetadata": true,
    "ValidateAfterConversion": true,
    "EnableAutoTypeConversion": true
  },
  "AllowedHosts": "*"
}
