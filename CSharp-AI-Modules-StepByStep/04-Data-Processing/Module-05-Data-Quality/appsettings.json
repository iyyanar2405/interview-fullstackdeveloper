{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "DataQuality": {
    "ValidationSettings": {
      "MaxRecordsPerBatch": 10000,
      "EnableParallelValidation": true,
      "TimeoutSeconds": 300
    },
    "ProfilingSettings": {
      "SampleSize": 1000,
      "CalculateStatistics": true,
      "MaxDistinctValuesForDistribution": 50
    },
    "AnomalyDetection": {
      "DefaultSensitivity": 0.95,
      "OutlierThreshold": 3.0,
      "MinimumDataPoints": 10,
      "WindowSize": 100
    },
    "Cleansing": {
      "AutoRemoveDuplicates": false,
      "AutoFillMissing": false,
      "MaxModificationsPerBatch": 100000
    },
    "Governance": {
      "ComplianceThreshold": 90.0,
      "EnableAutoRemediation": false,
      "RetentionDays": 90
    }
  },
  "AllowedHosts": "*"
}
