{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "SqlServer": {
    "Server": "localhost",
    "Database": "StorageDemo",
    "UserId": "sa",
    "Password": "YourPassword123!",
    "TrustServerCertificate": true,
    "MultipleActiveResultSets": true,
    "MaxPoolSize": 100,
    "MinPoolSize": 5,
    "CommandTimeout": 30
  },
  
  "PostgreSQL": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "storage_demo",
    "Username": "postgres",
    "Password": "yourpassword",
    "Pooling": true,
    "MaxPoolSize": 100,
    "MinPoolSize": 5,
    "CommandTimeout": 30
  },
  
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "storage_demo",
    "MaxConnectionPoolSize": 100,
    "MinConnectionPoolSize": 5,
    "MaxConnectionIdleTime": "00:10:00",
    "ConnectTimeout": "00:00:30",
    "SocketTimeout": "00:05:00"
  },
  
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Database": 0,
    "ConnectTimeout": "00:00:05",
    "SyncTimeout": "00:00:05",
    "ConnectRetry": 3,
    "AbortOnConnectFail": false,
    "AllowAdmin": false
  },
  
  "AzureBlob": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net",
    "ContainerName": "storage-demo",
    "MaxRetries": 3,
    "RetryDelay": "00:00:02"
  },
  
  "AzureDataLake": {
    "AccountName": "youraccount",
    "AccountKey": "yourkey",
    "FileSystemName": "storage-demo",
    "ServiceUri": "https://youraccount.dfs.core.windows.net"
  },
  
  "AwsS3": {
    "AccessKey": "YOUR_ACCESS_KEY",
    "SecretKey": "YOUR_SECRET_KEY",
    "BucketName": "storage-demo",
    "Region": "us-east-1",
    "UseAccelerateEndpoint": false
  },
  
  "DynamoDB": {
    "AccessKey": "YOUR_ACCESS_KEY",
    "SecretKey": "YOUR_SECRET_KEY",
    "Region": "us-east-1",
    "TableName": "storage-demo"
  },
  
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "Username": "",
    "Password": "",
    "DefaultIndex": "storage-demo",
    "MaxRetries": 3,
    "RequestTimeout": "00:00:30"
  },
  
  "CacheOptions": {
    "DefaultExpiration": "00:30:00",
    "EnableCompression": false,
    "EnableDistributedLock": false,
    "LockTimeout": "00:00:10"
  },
  
  "DataWarehouse": {
    "ConnectionString": "Server=localhost;Database=DataWarehouse;...",
    "WarehouseName": "MainWarehouse",
    "EnablePartitioning": true,
    "PartitionStrategy": "Monthly",
    "EnableCompression": true
  },
  
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/storage-solutions-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
