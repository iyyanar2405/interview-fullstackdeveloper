{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Module_02_Input_Validation": "Information"
    }
  },
  "AllowedHosts": "*",
  
  "Validation": {
    "EnableAutoValidation": true,
    "StrictMode": false,
    "LogValidationErrors": true,
    "ThrowOnValidationError": false,
    "MaxInputLength": 10000,
    "MaxCollectionSize": 1000
  },

  "Sanitization": {
    "Html": {
      "AllowedTags": ["p", "br", "strong", "em", "u", "a", "ul", "ol", "li", "h1", "h2", "h3"],
      "AllowedAttributes": ["href", "title", "class"],
      "AllowedProtocols": ["http", "https", "mailto"],
      "RemoveScripts": true,
      "RemoveStyles": false,
      "EncodeHtml": true
    },
    "Sql": {
      "RemoveSqlKeywords": true,
      "EscapeQuotes": true,
      "RemoveComments": true
    }
  },

  "FileValidation": {
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".txt"],
    "AllowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "text/plain"
    ],
    "MaxFileSizeBytes": 10485760,
    "CheckMimeType": true,
    "CheckFileSignature": true,
    "AllowExecutables": false
  },

  "SecurityThresholds": {
    "SqlInjectionRiskThreshold": 5.0,
    "XssRiskThreshold": 5.0,
    "CommandInjectionRiskThreshold": 5.0,
    "MaxFailedValidationAttempts": 10,
    "ValidationAttemptWindow Minutes": 60
  },

  "BlockedDomains": [
    "tempmail.com",
    "throwaway.email",
    "guerrillamail.com"
  ],

  "ProfanityFilter": {
    "Enabled": true,
    "BlockedWords": ["badword1", "badword2"]
  }
}
