{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Module_04_Data_Protection": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Urls": "https://localhost:7004;http://localhost:5004",
  
  "AzureKeyVault": {
    "VaultUrl": "https://your-keyvault.vault.azure.net/",
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "ClientSecret": "your-client-secret"
  },
  
  "Encryption": {
    "DefaultAlgorithm": "AES256",
    "KeyRotationDays": 90,
    "EncryptAtRest": true,
    "EncryptInTransit": true,
    "AllowedAlgorithms": [
      "AES128",
      "AES192",
      "AES256",
      "RSA2048",
      "RSA4096",
      "ChaCha20"
    ]
  },
  
  "GDPR": {
    "DataRetentionDays": 365,
    "RequestResponseDays": 30,
    "EnableConsentTracking": true,
    "RequiredConsents": [
      "marketing",
      "analytics",
      "third-party-sharing"
    ],
    "DataProtectionOfficerEmail": "dpo@yourcompany.com",
    "AutoDeleteAfterRetention": false
  },
  
  "Anonymization": {
    "DefaultMethod": "Pseudonymization",
    "EnableReversibleAnonymization": false,
    "KAnonymityK": 5,
    "PerturbationRange": 5.0,
    "FieldMappings": {
      "email": "Masking",
      "phone": "Masking",
      "ssn": "Suppression",
      "age": "Generalization",
      "salary": "Perturbation"
    }
  },
  
  "Audit": {
    "EnableAuditLogging": true,
    "RetentionDays": 730,
    "MinimumSeverity": "Information",
    "EnableTamperProofing": true,
    "EnableRealTimeAlerts": true,
    "AlertSeverityThreshold": "Warning",
    "StorageLocation": "database"
  },
  
  "Compliance": {
    "Frameworks": [
      "GDPR",
      "CCPA",
      "HIPAA",
      "SOC2"
    ],
    "EnableAutomatedReports": true,
    "ReportSchedule": "Monthly",
    "ComplianceScoreThreshold": 85.0
  },
  
  "Database": {
    "ConnectionString": "Server=localhost;Database=DataProtection;Trusted_Connection=True;TrustServerCertificate=True;",
    "Provider": "SqlServer",
    "CommandTimeout": 30,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3
  },
  
  "Security": {
    "EnableRateLimiting": true,
    "RateLimitPerMinute": 100,
    "RequireApiKey": false,
    "EnableIpWhitelist": false,
    "AllowedIpRanges": []
  }
}
