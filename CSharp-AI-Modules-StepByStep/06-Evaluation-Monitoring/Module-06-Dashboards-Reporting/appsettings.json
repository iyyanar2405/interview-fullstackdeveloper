{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Dashboard": {
    "SnapshotHistory": 96,
    "TrendHistoryMinutes": 1440,
    "SeedKpis": [
      {
        "Name": "Latency P95",
        "Value": 220,
        "Delta": -12,
        "Trend": "down"
      },
      {
        "Name": "Throughput",
        "Value": 82,
        "Delta": 4,
        "Trend": "up"
      },
      {
        "Name": "Error Rate",
        "Value": 2.4,
        "Delta": 0.2,
        "Trend": "flat"
      }
    ],
    "SeedDashboards": [
      {
        "DashboardId": "operations-overview",
        "Name": "Operations Overview",
        "Description": "Real-time operational KPIs for AI workloads.",
        "Tags": [
          "operations",
          "latency",
          "quality"
        ],
        "RefreshSeconds": 30,
        "IsDefault": true,
        "Widgets": [
          {
            "WidgetId": "latency-trend",
            "Type": "Timeseries",
            "Title": "Response Time (P95)",
            "Metric": "latency.p95",
            "Visualization": "line",
            "TimeRange": "6h",
            "Highlight": true,
            "Thresholds": {
              "warning": 280
            }
          },
          {
            "WidgetId": "throughput-trend",
            "Type": "Timeseries",
            "Title": "Throughput (RPS)",
            "Metric": "throughput.rps",
            "Visualization": "area",
            "TimeRange": "6h",
            "Highlight": true
          },
          {
            "WidgetId": "error-rate",
            "Type": "Timeseries",
            "Title": "Error Rate (%)",
            "Metric": "errors.rate",
            "Visualization": "line",
            "TimeRange": "6h",
            "Thresholds": {
              "warning": 5
            }
          },
          {
            "WidgetId": "regional-distribution",
            "Type": "Table",
            "Title": "Latency by Region",
            "Metric": "latency.p95",
            "Visualization": "table",
            "TimeRange": "1h"
          }
        ]
      },
      {
        "DashboardId": "business-health",
        "Name": "Business Health",
        "Description": "Executive summary of business KPIs.",
        "Tags": [
          "business",
          "cost",
          "uptime"
        ],
        "RefreshSeconds": 60,
        "IsDefault": false,
        "Widgets": [
          {
            "WidgetId": "cost-trend",
            "Type": "Timeseries",
            "Title": "Cost per Request",
            "Metric": "cost.per.request",
            "Visualization": "line",
            "TimeRange": "24h",
            "Highlight": true
          },
          {
            "WidgetId": "uptime-gauge",
            "Type": "Number",
            "Title": "Uptime (%)",
            "Metric": "uptime.percent",
            "Visualization": "gauge",
            "TimeRange": "24h",
            "Highlight": true
          },
          {
            "WidgetId": "exec-summary",
            "Type": "Markdown",
            "Title": "Executive Narrative",
            "Metric": "executive.summary",
            "Visualization": "markdown",
            "TimeRange": "24h"
          }
        ]
      }
    ]
  },
  "Reporting": {
    "AllowedFormats": [
      "json",
      "pdf",
      "csv"
    ],
    "DefaultGroupBy": "hour",
    "MaxRangeDays": 30
  },
  "MetricsSimulation": {
    "Metrics": [
      "latency.p95",
      "throughput.rps",
      "errors.rate",
      "cost.per.request",
      "uptime.percent"
    ],
    "Baseline": {
      "latency.p95": 220,
      "throughput.rps": 80,
      "errors.rate": 2.5,
      "cost.per.request": 0.019,
      "uptime.percent": 99.6
    },
    "Volatility": {
      "latency.p95": 15,
      "throughput.rps": 5,
      "errors.rate": 0.8,
      "cost.per.request": 0.002,
      "uptime.percent": 0.05
    },
    "IntervalSeconds": 15
  },
  "AllowedHosts": "*"
}
