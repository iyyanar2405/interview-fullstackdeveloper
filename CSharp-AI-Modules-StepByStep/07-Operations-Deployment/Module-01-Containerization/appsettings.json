{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Containerization": {
    "Templates": [
      {
        "Name": "dotnet-api",
        "Description": "Multi-stage build targeting ASP.NET Core APIs",
        "BaseImage": "mcr.microsoft.com/dotnet/sdk:8.0-alpine",
        "MultiStage": true,
        "BuildStageSteps": [
          "COPY . ./",
          "RUN dotnet restore",
          "RUN dotnet publish -c Release -o /app/publish --no-restore"
        ],
        "RuntimeStageSteps": [
          "FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS runtime",
          "WORKDIR /app",
          "COPY --from=build /app/publish ./",
          "ENTRYPOINT [\"dotnet\", \"app.dll\"]"
        ],
        "ExposedPorts": [
          "8080",
          "8443"
        ],
        "Labels": [
          "org.opencontainers.image.source=https://github.com/example/ai-service",
          "org.opencontainers.image.description=AI service container"
        ],
        "Arguments": {
          "CONFIGURATION": "Release"
        },
        "OptimizationTips": [
          "Use dotnet publish with trimming for minimal runtime size.",
          "Leverage BuildKit caching with --mount=type=cache for NuGet packages."
        ]
      },
      {
        "Name": "python-worker",
        "Description": "Python background worker with slim base image",
        "BaseImage": "python:3.11-slim",
        "MultiStage": false,
        "BuildStageSteps": [],
        "RuntimeStageSteps": [
          "COPY requirements.txt ./",
          "RUN pip install --no-cache-dir -r requirements.txt",
          "COPY . ./",
          "CMD [\"python\", \"worker.py\"]"
        ],
        "ExposedPorts": [
          "8000"
        ],
        "Labels": [
          "org.opencontainers.image.licenses=MIT"
        ],
        "Arguments": {},
        "OptimizationTips": [
          "Pin dependency versions to improve layer caching.",
          "Add a non-root user for runtime security."
        ]
      }
    ],
    "ComposeProfiles": [
      {
        "Name": "local-dev",
        "Description": "Local development with API + Postgres",
        "Services": [
          {
            "ServiceName": "api",
            "BuildContext": "./",
            "Environment": {
              "ASPNETCORE_ENVIRONMENT": "Development",
              "ConnectionStrings__Database": "Host=db;Port=5432;Username=postgres;Password=postgres;Database=ai"
            },
            "Ports": [
              8080
            ],
            "DependsOn": [
              "db"
            ],
            "Volumes": {
              "aspnethttps": "/root/.aspnet/https",
              "nuget": "/root/.nuget"
            }
          },
          {
            "ServiceName": "db",
            "Image": "postgres:15-alpine",
            "Environment": {
              "POSTGRES_PASSWORD": "postgres",
              "POSTGRES_DB": "ai"
            },
            "Ports": [
              5432
            ]
          }
        ]
      },
      {
        "Name": "observability",
        "Description": "API with OpenTelemetry Collector and Jaeger",
        "Services": [
          {
            "ServiceName": "api",
            "BuildContext": "./",
            "Environment": {
              "OTEL_EXPORTER_OTLP_ENDPOINT": "http://collector:4317"
            },
            "Ports": [
              8080
            ],
            "DependsOn": [
              "collector"
            ]
          },
          {
            "ServiceName": "collector",
            "Image": "otel/opentelemetry-collector:0.91.0",
            "Command": [
              "--config=/etc/otel-collector-config.yaml"
            ],
            "Volumes": {
              "./otel-collector-config.yaml": "/etc/otel-collector-config.yaml"
            },
            "DependsOn": [
              "jaeger"
            ]
          },
          {
            "ServiceName": "jaeger",
            "Image": "jaegertracing/all-in-one:1.54",
            "Ports": [
              16686,
              14268
            ]
          }
        ]
      }
    ],
    "Simulation": {
      "Concurrency": 2,
      "ProcessingDelaySeconds": 7,
      "SampleRegistries": [
        "registry.internal/ai-platform",
        "ghcr.io/company/ai",
        "azurecr.io/ai"
      ]
    }
  },
  "AllowedHosts": "*"
}
