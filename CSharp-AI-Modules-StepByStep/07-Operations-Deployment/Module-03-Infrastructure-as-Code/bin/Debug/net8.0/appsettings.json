{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Infrastructure": {
    "Simulation": {
      "WorkerIntervalSeconds": 4,
      "DriftLikelihood": 0.25,
      "DefaultRequestedBy": "iac-automation@contoso.com",
      "DefaultProvider": "terraform",
      "DefaultRegion": "eastus",
      "Environments": [
        "dev",
        "staging",
        "production"
      ]
    },
    "Templates": [
      {
        "Name": "azure-webapp",
        "Provider": "terraform",
        "Description": "Azure App Service with storage and monitoring",
        "Tags": [
          "azure",
          "webapp",
          "monitoring"
        ],
        "Variables": {
          "location": "eastus",
          "environment": "dev",
          "tags": "{ project = \"ai-platform\" }"
        },
        "Resources": [
          {
            "Name": "app-service-plan",
            "Type": "azurerm_app_service_plan",
            "Properties": {
              "sku_name": "P1v3",
              "resource_group_name": "rg-ai-platform",
              "api_version": "2022-09-01"
            },
            "SecurityControls": {
              "encryption": "enabled"
            }
          },
          {
            "Name": "app-service",
            "Type": "azurerm_app_service",
            "Properties": {
              "https_only": "true",
              "minimum_tls_version": "1.2",
              "identity_type": "SystemAssigned",
              "app_service_plan_id": "app-service-plan.id",
              "api_version": "2022-09-01"
            },
            "SecurityControls": {
              "https_only": "required",
              "identity": "managed"
            }
          },
          {
            "Name": "storage",
            "Type": "azurerm_storage_account",
            "Properties": {
              "account_kind": "StorageV2",
              "account_tier": "Standard",
              "access_tier": "Hot",
              "min_tls_version": "TLS1_2",
              "api_version": "2022-09-01"
            },
            "SecurityControls": {
              "min_tls_version": "TLS1_2",
              "https_only": "true"
            }
          }
        ]
      },
      {
        "Name": "aws-eks",
        "Provider": "terraform",
        "Description": "AWS EKS cluster with managed node group",
        "Tags": [
          "aws",
          "eks"
        ],
        "Variables": {
          "aws_region": "us-east-1",
          "cluster_version": "1.29"
        },
        "Resources": [
          {
            "Name": "vpc",
            "Type": "aws_vpc",
            "Properties": {
              "cidr_block": "10.0.0.0/16",
              "enable_dns_hostnames": "true"
            },
            "SecurityControls": {
              "dns_hostnames": "enabled"
            }
          },
          {
            "Name": "eks-cluster",
            "Type": "aws_eks_cluster",
            "Properties": {
              "version": "1.29",
              "role_arn": "arn:aws:iam::123456789012:role/EKSClusterRole",
              "vpc_config": "{ subnet_ids = [\"subnet-1\", \"subnet-2\"], endpoint_private_access = true }"
            },
            "SecurityControls": {
              "endpoint_private_access": "true"
            }
          }
        ]
      }
    ],
    "ComplianceRules": [
      {
        "Id": "https-only",
        "Description": "App Services must enforce HTTPS",
        "Severity": "high",
        "AppliesTo": [
          "azurerm_app_service"
        ],
        "Requirements": {
          "https_only": "true"
        }
      },
      {
        "Id": "tls-version",
        "Description": "TLS 1.2 minimum required for storage",
        "Severity": "medium",
        "AppliesTo": [
          "storage"
        ],
        "Requirements": {
          "min_tls_version": "TLS1_2"
        }
      },
      {
        "Id": "eks-private-endpoint",
        "Description": "EKS clusters should enable private endpoint access",
        "Severity": "medium",
        "AppliesTo": [
          "aws_eks_cluster"
        ],
        "Requirements": {
          "endpoint_private_access": "true"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
