{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Scaling": {
    "Forecast": {
      "CpuGrowthPercentage": 25,
      "RequestGrowthPercentage": 40,
      "ForecastHorizonMinutes": 90
    },
    "Simulation": {
      "WorkerIntervalSeconds": 3,
      "MaxParallelSimulations": 3,
      "Environments": [
        "dev",
        "test",
        "production"
      ],
      "Scenarios": [
        {
          "Name": "api-rush",
          "Pattern": "spiky",
          "PeakRequestsPerSecond": 800,
          "BaseRequestsPerSecond": 200,
          "DurationMinutes": 45,
          "ErrorBudgetPercent": 1
        },
        {
          "Name": "batch-window",
          "Pattern": "wave",
          "PeakRequestsPerSecond": 400,
          "BaseRequestsPerSecond": 150,
          "DurationMinutes": 60,
          "ErrorBudgetPercent": 0.5
        }
      ]
    },
    "Profiles": [
      {
        "Name": "web-app-tier",
        "Description": "Primary web tier running API workloads",
        "WorkloadType": "web",
        "ResourceType": "AzureAppService",
        "MinInstances": 2,
        "MaxInstances": 12,
        "ScaleOutStep": 2,
        "ScaleInStep": 1,
        "Cpu": {
          "ScaleOut": 65,
          "ScaleIn": 35
        },
        "Memory": {
          "ScaleOut": 70,
          "ScaleIn": 40
        },
        "Requests": {
          "ScaleOut": 220,
          "ScaleIn": 90
        },
        "CostPerInstance": 0.28,
        "Regions": [
          "eastus",
          "westus2"
        ],
        "Tags": {
          "team": "platform",
          "tier": "api"
        }
      },
      {
        "Name": "worker-jobs",
        "Description": "Background processing nodes",
        "WorkloadType": "worker",
        "ResourceType": "AKS",
        "MinInstances": 3,
        "MaxInstances": 20,
        "ScaleOutStep": 3,
        "ScaleInStep": 2,
        "Cpu": {
          "ScaleOut": 75,
          "ScaleIn": 40
        },
        "Memory": {
          "ScaleOut": 80,
          "ScaleIn": 45
        },
        "Requests": {
          "ScaleOut": 180,
          "ScaleIn": 60
        },
        "CostPerInstance": 0.35,
        "Regions": [
          "eastus"
        ],
        "Tags": {
          "team": "ml-team",
          "tier": "processing"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
