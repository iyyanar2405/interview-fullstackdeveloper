{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "CloudDeployment": {
    "Integrations": {
      "ObservabilityStack": "azure-monitor",
      "SecretsProvider": "key-vault",
      "Registry": "registry.azurecr.io/ai"
    },
    "Simulation": {
      "WorkerIntervalSeconds": 3,
      "FailureRate": 0.1,
      "Regions": [
        "eastus",
        "westeurope"
      ],
      "Providers": [
        "azure",
        "aws"
      ],
      "TrafficSplits": [
        "100-0",
        "90-10",
        "70-30",
        "50-50"
      ]
    },
    "Guardrails": [
      {
        "Id": "slot-traffic-check",
        "Description": "Ensure deployment slots warmed before traffic switch",
        "Severity": "high",
        "AppliesTo": "slot",
        "Remediation": "Run smoke tests prior to swap"
      },
      {
        "Id": "aws-observability",
        "Description": "AWS workloads must configure CloudWatch alarms",
        "Severity": "medium",
        "AppliesTo": "aws",
        "Remediation": "Provision baseline CloudWatch alarms before release"
      }
    ],
    "Blueprints": [
      {
        "Name": "azure-appservice-bluegreen",
        "Provider": "azure",
        "Environment": "production",
        "DeploymentModel": "blue-green",
        "Tags": {
          "team": "platform",
          "compliance": "soc2"
        },
        "Components": [
          {
            "Name": "api",
            "Type": "app-service",
            "Image": "registry.azurecr.io/ai/api:latest",
            "Size": "P1v3",
            "Configuration": {
              "healthProbe": "/health",
              "autoscale": "true"
            }
          },
          {
            "Name": "background-worker",
            "Type": "container-app",
            "Image": "registry.azurecr.io/ai/worker:latest",
            "Size": "D4",
            "Configuration": {
              "concurrency": "4"
            }
          }
        ],
        "TrafficStrategies": [
          {
            "Name": "blue-green",
            "Pattern": "blue-green",
            "Description": "Deploy green slot then swap",
            "Steps": [
              "Deploy green slot",
              "Run smoke tests",
              "Swap traffic"
            ]
          }
        ]
      },
      {
        "Name": "aws-ecs-canary",
        "Provider": "aws",
        "Environment": "staging",
        "DeploymentModel": "canary",
        "Components": [
          {
            "Name": "service",
            "Type": "ecs-service",
            "Image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/ai:latest",
            "Size": "medium",
            "Configuration": {
              "desiredCount": "3"
            }
          }
        ],
        "TrafficStrategies": [
          {
            "Name": "canary",
            "Pattern": "canary",
            "Description": "Shift traffic gradually",
            "Steps": [
              "Shift 10%",
              "Observe",
              "Shift remaining"
            ]
          }
        ]
      }
    ]
  },
  "AllowedHosts": "*"
}
