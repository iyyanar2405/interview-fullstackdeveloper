{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Monitoring": {
    "Simulation": {
      "MetricIntervalSeconds": 5,
      "IncidentLikelihood": 0.2,
      "Regions": [
        "eastus",
        "westeurope"
      ],
      "Services": [
        "payments",
        "checkout",
        "identity"
      ],
      "Seed": 42
    },
    "Dashboards": [
      {
        "Name": "Payments - Golden Signals",
        "Description": "Latency, traffic, errors, saturation for payments service",
        "Widgets": [
          {
            "Title": "Request Latency",
            "Visualization": "line",
            "Metric": "latency",
            "Query": "p95(latency) by region"
          },
          {
            "Title": "Traffic Volume",
            "Visualization": "bar",
            "Metric": "requests",
            "Query": "sum(requests) by region"
          },
          {
            "Title": "Error Rate",
            "Visualization": "line",
            "Metric": "errors",
            "Query": "error_rate"
          }
        ]
      }
    ],
    "AlertRules": [
      {
        "Name": "payments-latency-p95",
        "Description": "Alert when 95th percentile latency exceeds 250ms",
        "Metric": "latency",
        "TargetEntity": "service",
        "TargetEntityId": "payments",
        "Operator": "GreaterThan",
        "Threshold": 250,
        "Severity": "High"
      },
      {
        "Name": "checkout-errors",
        "Description": "Alert when checkout error count exceeds threshold",
        "Metric": "errors",
        "TargetEntity": "service",
        "TargetEntityId": "checkout",
        "Operator": "GreaterThanOrEqual",
        "Threshold": 5,
        "Severity": "Medium"
      }
    ],
    "ServiceLevelObjectives": [
      {
        "Name": "payments-availability",
        "Service": "payments",
        "Metric": "availability",
        "Direction": "GreaterThanOrEqual",
        "Target": 99.9,
        "Aggregation": "avg",
        "Window": "00:05:00",
        "Period": "rolling"
      },
      {
        "Name": "checkout-latency",
        "Service": "checkout",
        "Metric": "latency",
        "Direction": "LessThanOrEqual",
        "Target": 200,
        "Aggregation": "p95",
        "Window": "00:10:00",
        "Period": "rolling"
      }
    ],
    "Reports": [
      {
        "Type": "shift-handover",
        "Notes": "Used by on-call engineer handing over the shift",
        "IncludeTelemetrySummary": true,
        "IncludeSloStatus": true,
        "IncludeAlertSummary": true,
        "IncludeIncidentSummary": true
      },
      {
        "Type": "executive-daily",
        "Notes": "Daily summary for leadership",
        "IncludeTelemetrySummary": true,
        "IncludeSloStatus": true,
        "IncludeAlertSummary": true,
        "IncludeIncidentSummary": false
      }
    ]
  },
  "AllowedHosts": "*"
}
