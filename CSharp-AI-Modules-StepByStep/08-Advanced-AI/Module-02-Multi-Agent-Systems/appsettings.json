{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "MultiAgent": {
    "Simulation": {
      "CoordinationIntervalMilliseconds": 250,
      "MaxConcurrentTasks": 8,
      "EscalationProbability": 0.15,
      "ConsensusFailureRate": 0.08
    },
    "Teams": [
      {
        "Name": "incident-response",
        "Mission": "Restore service health during production incidents",
        "Roles": [
          {
            "RoleId": "commander",
            "Persona": "Calm incident commander guiding response",
            "Skills": [
              "prioritization",
              "communication"
            ],
            "Capacity": 1,
            "DecisionRights": [
              "approve_mitigation",
              "escalate"
            ]
          },
          {
            "RoleId": "analyst",
            "Persona": "Telemetry analyst gathering proof",
            "Skills": [
              "observability",
              "diagnostics"
            ],
            "Capacity": 2,
            "DecisionRights": [
              "propose_fix"
            ]
          },
          {
            "RoleId": "sre",
            "Persona": "Site reliability engineer applying mitigations",
            "Skills": [
              "mitigation",
              "automation"
            ],
            "Capacity": 2,
            "DecisionRights": [
              "deploy_hotfix"
            ]
          }
        ],
        "PreferredChannels": [
          "war-room"
        ],
        "Playbooks": [
          "p0-incident"
        ]
      },
      {
        "Name": "product-discovery",
        "Mission": "Explore new feature opportunities collaboratively",
        "Roles": [
          {
            "RoleId": "pm",
            "Persona": "Vision-oriented product manager",
            "Skills": [
              "framing",
              "research"
            ],
            "Capacity": 1,
            "DecisionRights": [
              "align_scope"
            ]
          },
          {
            "RoleId": "designer",
            "Persona": "Experience designer prototyping flows",
            "Skills": [
              "ideation",
              "storyboarding"
            ],
            "Capacity": 1,
            "DecisionRights": [
              "approve_wireframe"
            ]
          },
          {
            "RoleId": "tech-lead",
            "Persona": "Engineer evaluating feasibility",
            "Skills": [
              "architecture",
              "estimation"
            ],
            "Capacity": 1,
            "DecisionRights": [
              "commit_tech_plan"
            ]
          }
        ],
        "PreferredChannels": [
          "design-review"
        ],
        "Playbooks": [
          "feature-discovery"
        ]
      }
    ],
    "Channels": [
      {
        "ChannelId": "war-room",
        "Type": "synchronous",
        "Description": "Live incident coordination channel",
        "SupportedMessageTypes": [
          "step-update",
          "decision",
          "alert"
        ],
        "Persistent": true
      },
      {
        "ChannelId": "design-review",
        "Type": "async",
        "Description": "Product discovery collaboration space",
        "SupportedMessageTypes": [
          "idea",
          "feedback",
          "decision"
        ],
        "Persistent": true
      }
    ],
    "Playbooks": [
      {
        "PlaybookId": "p0-incident",
        "Name": "P0 Incident Response",
        "Summary": "Stabilise production outages using triage, mitigation, and comms",
        "Steps": [
          {
            "StepId": "triage",
            "OwnerRoleId": "analyst",
            "Objective": "Gather telemetry and identify blast radius",
            "RequiredSkills": [
              "diagnostics"
            ],
            "HandOff": "commander"
          },
          {
            "StepId": "mitigate",
            "OwnerRoleId": "sre",
            "Objective": "Deploy mitigation or rollback",
            "RequiredSkills": [
              "mitigation"
            ],
            "HandOff": "commander"
          },
          {
            "StepId": "communicate",
            "OwnerRoleId": "commander",
            "Objective": "Broadcast status updates",
            "RequiredSkills": [
              "communication"
            ],
            "HandOff": "commander"
          }
        ]
      },
      {
        "PlaybookId": "feature-discovery",
        "Name": "Feature Discovery",
        "Summary": "Explore opportunity and align on solution",
        "Steps": [
          {
            "StepId": "frame",
            "OwnerRoleId": "pm",
            "Objective": "Define problem hypothesis and success metrics",
            "RequiredSkills": [
              "framing"
            ],
            "HandOff": "designer"
          },
          {
            "StepId": "ideate",
            "OwnerRoleId": "designer",
            "Objective": "Visualise candidate experiences",
            "RequiredSkills": [
              "ideation"
            ],
            "HandOff": "tech-lead"
          },
          {
            "StepId": "validate",
            "OwnerRoleId": "tech-lead",
            "Objective": "Assess feasibility and estimate effort",
            "RequiredSkills": [
              "estimation"
            ],
            "HandOff": "pm"
          }
        ]
      }
    ]
  },
  "AllowedHosts": "*"
}
