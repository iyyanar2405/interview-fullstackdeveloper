{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ToolIntegration": {
    "Simulation": {
      "WorkerIntervalMilliseconds": 250,
      "FailureProbability": 0.1,
      "MaxLogEntries": 200,
      "MaxDataRecords": 200
    },
    "ApiTools": [
      {
        "ToolId": "weather-api",
        "Name": "Weather Forecast API",
        "Description": "Provides simulated weather forecast data.",
        "BaseUrl": "https://api.example.com/weather",
        "Method": "GET",
        "SupportedOperations": [
          "current",
          "forecast"
        ],
        "DefaultHeaders": {
          "Authorization": "Bearer sample-token",
          "Accept": "application/json"
        },
        "SampleParameters": {
          "path": "current",
          "query": "city=Seattle"
        },
        "ResponseTemplates": [
          {
            "Operation": "current",
            "Narrative": "Retrieved current weather conditions for the requested location.",
            "Outputs": {
              "temperatureC": "18",
              "condition": "Cloudy",
              "humidity": "70"
            }
          },
          {
            "Operation": "forecast",
            "Narrative": "Generated five-day forecast for the requested city.",
            "Outputs": {
              "day1": "Rain",
              "day2": "Cloudy",
              "day3": "Partly Cloudy",
              "day4": "Sunny",
              "day5": "Sunny"
            }
          }
        ]
      }
    ],
    "DatabaseTools": [
      {
        "ToolId": "sales-db",
        "Name": "Sales Analytics Database",
        "Description": "Simulated sales and customer records for analytics scenarios.",
        "Engine": "PostgreSQL",
        "SupportedOperations": [
          "select",
          "aggregate"
        ],
        "Tables": [
          {
            "TableName": "customers",
            "Rows": [
              {
                "customerId": "C001",
                "name": "Alice Johnson",
                "region": "Northwest",
                "lifetimeValue": "12000"
              },
              {
                "customerId": "C002",
                "name": "Ben Martinez",
                "region": "Southwest",
                "lifetimeValue": "8000"
              }
            ]
          },
          {
            "TableName": "orders",
            "Rows": [
              {
                "orderId": "O1001",
                "customerId": "C001",
                "amount": "450",
                "status": "Shipped"
              },
              {
                "orderId": "O1002",
                "customerId": "C002",
                "amount": "220",
                "status": "Processing"
              }
            ]
          }
        ]
      }
    ],
    "FileSystemTools": [
      {
        "ToolId": "report-fs",
        "Name": "Report File System",
        "Description": "Virtual file system for generating reports and storing artifacts.",
        "RootPath": "/virtual/reports",
        "Capabilities": [
          "list",
          "read",
          "write",
          "delete"
        ],
        "SeedFiles": [
          {
            "Path": "templates/welcome.txt",
            "Content": "Welcome to the reporting system."
          },
          {
            "Path": "archive/2024/summary.txt",
            "Content": "Sales summary for 2024 Q1"
          }
        ]
      }
    ],
    "WebScrapingTools": [
      {
        "ToolId": "news-scraper",
        "Name": "Market News Scraper",
        "Description": "Scrapes economic news headlines from a simulated portal.",
        "TargetUrl": "https://news.example.com/markets",
        "Selectors": {
          "headline": ".headline",
          "summary": ".summary"
        },
        "Samples": [
          {
            "Selector": ".headline",
            "Content": "Global markets rally on positive earnings",
            "CapturedAt": "2025-10-15T08:00:00Z"
          },
          {
            "Selector": ".summary",
            "Content": "Tech sector leads gains with strong quarterly reports",
            "CapturedAt": "2025-10-15T08:05:00Z"
          }
        ]
      }
    ],
    "CustomTools": [
      {
        "ToolId": "summarizer",
        "Name": "Text Summarizer",
        "Description": "Generates summaries from provided content using pre-defined strategies.",
        "Parameters": [
          "input",
          "style",
          "length"
        ],
        "Behaviors": {
          "default": "Summarized content using balanced tone.",
          "executive": "Summarized content emphasizing business outcomes.",
          "technical": "Summarized content focusing on technical details."
        },
        "DefaultOutputs": {
          "confidence": "0.92",
          "tokensUsed": "256"
        }
      }
    ]
  }
}
