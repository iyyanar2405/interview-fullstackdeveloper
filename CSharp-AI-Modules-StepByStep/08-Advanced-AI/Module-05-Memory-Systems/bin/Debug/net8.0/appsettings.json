{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "MemorySystems": {
    "Simulation": {
      "ConsolidationIntervalMilliseconds": 1200,
      "AutoConsolidationImportanceThreshold": 0.75,
      "MaxEntriesPerStore": 1024,
      "ShortTermRetentionMinutes": 60,
      "MaxConsolidationEvents": 150
    },
    "Profiles": [
      {
        "ProfileId": "product-discovery",
        "Name": "Product Discovery Agent",
        "Description": "Captures research insights, user feedback, and synthesized knowledge for product planning.",
        "DefaultTags": [
          "product",
          "discovery"
        ],
        "RetrievalStrategies": [
          "importance-first",
          "recent-first"
        ],
        "Stores": [
          {
            "StoreId": "short-term",
            "MemoryType": "short-term",
            "Description": "Working set of recent research notes and observations.",
            "Capacity": 200,
            "ImportanceFloor": 0.2,
            "EnableAutoSummaries": true,
            "PromoteToStoreId": "long-term",
            "DefaultTags": [
              "recent"
            ]
          },
          {
            "StoreId": "episodic",
            "MemoryType": "episodic",
            "Description": "Chronological experiences sourced from research sessions.",
            "Capacity": 300,
            "ImportanceFloor": 0.25,
            "EnableAutoSummaries": false,
            "DefaultTags": [
              "session"
            ]
          },
          {
            "StoreId": "long-term",
            "MemoryType": "long-term",
            "Description": "Curated summaries and enduring product knowledge.",
            "Capacity": 400,
            "ImportanceFloor": 0.4,
            "EnableAutoSummaries": true,
            "PromoteToStoreId": "semantic",
            "DefaultTags": [
              "archive"
            ]
          },
          {
            "StoreId": "semantic",
            "MemoryType": "semantic",
            "Description": "Structured facts, personas, and key product principles.",
            "Capacity": 500,
            "ImportanceFloor": 0.5,
            "EnableAutoSummaries": false,
            "DefaultTags": [
              "canon"
            ]
          }
        ],
        "Retention": {
          "ShortTermMinutes": 120,
          "LongTermDays": 180,
          "EpisodicDays": 45
        }
      },
      {
        "ProfileId": "incident-response",
        "Name": "Incident Response Agent",
        "Description": "Tracks operational incidents, root-cause analyses, and postmortem learnings.",
        "DefaultTags": [
          "operations",
          "incident"
        ],
        "RetrievalStrategies": [
          "critical-first",
          "timeline"
        ],
        "Stores": [
          {
            "StoreId": "working",
            "MemoryType": "working",
            "Description": "Live incident context and ongoing investigation notes.",
            "Capacity": 150,
            "ImportanceFloor": 0.3,
            "EnableAutoSummaries": true,
            "PromoteToStoreId": "episodic",
            "DefaultTags": [
              "live",
              "status"
            ]
          },
          {
            "StoreId": "episodic",
            "MemoryType": "episodic",
            "Description": "Incident timelines and actions captured during response.",
            "Capacity": 260,
            "ImportanceFloor": 0.35,
            "EnableAutoSummaries": true,
            "PromoteToStoreId": "knowledge-base",
            "DefaultTags": [
              "timeline"
            ]
          },
          {
            "StoreId": "knowledge-base",
            "MemoryType": "long-term",
            "Description": "Actionable learnings, mitigations, and playbook updates.",
            "Capacity": 380,
            "ImportanceFloor": 0.45,
            "EnableAutoSummaries": true,
            "PromoteToStoreId": "semantic",
            "DefaultTags": [
              "lesson"
            ]
          },
          {
            "StoreId": "semantic",
            "MemoryType": "semantic",
            "Description": "Structured mitigations and best practices.",
            "Capacity": 420,
            "ImportanceFloor": 0.5,
            "EnableAutoSummaries": false,
            "DefaultTags": [
              "best-practice"
            ]
          }
        ],
        "Retention": {
          "ShortTermMinutes": 90,
          "LongTermDays": 365,
          "EpisodicDays": 120
        }
      }
    ]
  }
}
